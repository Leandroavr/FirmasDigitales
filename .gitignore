# Dependencies
node_modules/
/node_modules
/.pnp
.pnp.js

# Production builds & dist
/build
dist/
apps/OpenSign/build/
apps/OpenSign/dist/
apps/OpenSign/public/mfbuild/*
microfrontends/SignDocuments/build/*

# Testing & Coverage
/coverage
.pytest_cache/
__pycache__/
*.py[cod]

# Secrets and Environment files (CRITICAL: Never commit secrets)
.env*
!.env.example

# Cryptographic Keys, Certificates & Keystores (CRITICAL)
*.p12
*.pfx
*.pem
*.crt
*.cer
*.key
*.pub
pem_prueba

