apps/CorporateSigner/certificates/*
!apps/CorporateSigner/certificates/.gitkeep
apps/CorporateSigner/signatures/*
!apps/CorporateSigner/signatures/README.md
!apps/CorporateSigner/signatures/.gitkeep

