# ==============================================================================
# Caddyfile - Configuración de Proxy Inverso y TLS para OpenSign Brascuba (PROD)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENTORNO DE PRODUCCIÓN (firmadigital.brascuba.cu / Puerto 3001 con TLS)
# ------------------------------------------------------------------------------
:3001 {
    tls internal {
        on_demand
    }

    # API Parse Server (Backend) con protección anti-spoofing de IP
    handle_path /api/* {
        reverse_proxy server:8080 {
            header_up X-Real-IP {remote_host}
            header_up Host {host}
        }
    }

    # Frontend React Web
    reverse_proxy client:3000 {
        header_up X-Real-IP {remote_host}
        header_up Host {host}
    }
}
