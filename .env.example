# ==============================================================================
# OpenSign Brascuba - Archivo de Configuración de Ejemplo (.env.example)
# ==============================================================================
# Copie este archivo a .env.prod para producción o .env para desarrollo local.
# NUNCA guarde contraseñas reales ni claves en este archivo de ejemplo.
#
# Generación de claves aleatorias seguras:
#   PowerShell: -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 64 | ForEach-Object {[char]$_})
#   Bash/Linux: openssl rand -hex 32
# ==============================================================================

# Dominio y URL base
HOST_URL=https://brascuba.cu:3001
PUBLIC_URL=https://brascuba.cu:3001
SERVER_URL=https://brascuba.cu:3001/api/app

# Frontend Config
GENERATE_SOURCEMAP=false
REACT_APP_SERVERURL=https://brascuba.cu:3001/api/app
REACT_APP_APPID=opensign
REACT_APP_GTM=

# Backend Express / Parse Server
APP_ID=opensign
appName=OpenSign_Brascuba
# Generar clave secreta larga (64 chars)
MASTER_KEY=GENERATE_RANDOM_64_CHAR_KEY_HERE
MONGODB_URI=mongodb://mongo:27017/opensign
PARSE_MOUNT=/app

# Corporate Signer (Microservicio Python de Firma Digital Brascuba)
CORPORATE_SIGNER_URL=http://corporate-signer:8090
# Token secreto de autenticación interna entre Node y Python (64 chars)
CORPORATE_SIGNER_TOKEN=GENERATE_RANDOM_64_CHAR_TOKEN_HERE
CORPORATE_TRUST_ROOTS=/trust/institution-roots.pem
CORPORATE_REVOCATION_MODE=soft-fail
CORPORATE_ALLOW_FETCHING=false
CORPORATE_SIGNING_TIME_TOLERANCE_SECONDS=86400
# Servidor TSA para sellado de tiempo RFC 3161
CORPORATE_TSA_URL=https://rfc3161.ai.moda
CORPORATE_CERTIFICATES_DIR=/app/certificates

# Configuración de Depuración de Documentos (Bloque B)
# true: Conserva registro lápida (metadatos, hash y firmantes) pero borra archivos y firmas en Base64
# false: Elimina completamente el registro de MongoDB
PURGE_KEEP_TOMBSTONE=true
# Días para depuración automática de completados/rechazados (0 = desactivado)
AUTO_PURGE_DAYS=0

# Storage: Local File Storage
USE_LOCAL=TRUE

# Servidor SMTP Brascuba para notificaciones por correo
SMTP_ENABLE=true
SMTP_HOST=mail.brascuba.cu
SMTP_PORT=587
SMTP_USER_EMAIL=notificaciones@brascuba.cu
SMTP_PASS=CONFIGURE_YOUR_SMTP_PASSWORD_HERE

# Certificado de la entidad para el cierre/sello final de documentos (opcional)
PFX_BASE64=
PASS_PHRASE=
